*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log

# Local secrets and credentials
.env
.env.*
!.env.example
kubeconfig*
*.pem
*.key
*.pfx
*.p12

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
